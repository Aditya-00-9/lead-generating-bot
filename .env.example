APP_NAME=kramaai-lead-monitor
APP_ENV=development
STRICT_STARTUP_VALIDATION=false
LOG_LEVEL=INFO
SENTRY_DSN=

# Random string (16+ chars). Required for GET /api/cron/daily-ingestion on Vercel; set the same value in Vercel project env as CRON_SECRET.
CRON_SECRET=

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRIAGE_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
MIN_ENRICH_SCORE=58
GATE1_FAIL_MIN_RELEVANCE=60
DIGEST_MIN_RANK_SCORE=0
TRIAGE_MIN_COLLECTION_RELEVANCE=45
QUALITY_FEEDBACK_MIN_AVG_SCORE=4.0
QUALITY_FEEDBACK_MIN_SAMPLES=2
ENRICHMENT_CONCURRENCY=5
TRIAGE_CONCURRENCY=10
REPLY_CONTEXT=KramaAI is studio management software for martial arts, yoga, and fitness studios. We compete with Mindbody, Pike13, MyStudio, etc. Focus on owners actively frustrated with pricing, contracts, support, or missing features.

# OpenAI web discovery (default on in app). Set false to skip web_search and save cost.
ENABLE_OPENAI_WEB_RESEARCH=true
# Discovery — OPENAI_RESPONSES_MODEL powers web_search; keep enrichment on gpt-4o-mini for cost.
OPENAI_RESPONSES_MODEL=gpt-4o
OPENAI_COLLECTION_MODEL=gpt-4o-mini
OPENAI_WEB_RESEARCH_MULTI_QUERY=true
OPENAI_WEB_RESEARCH_MAX_SEARCHES=18
OPENAI_WEB_RESEARCH_SEARCH_CONCURRENCY=3
OPENAI_WEB_RESEARCH_COMPETITORS_PER_RUN=4
OPENAI_WEB_RESEARCH_DISCOVERY_POOL_SIZE=80
# Per-search tool budget (multi-query mode). Legacy single-shot uses openai_web_research_max_tool_calls in settings (default 12) when multi-query is false.
OPENAI_WEB_RESEARCH_MAX_TOOL_CALLS_PER_SEARCH=4
OPENAI_WEB_RESEARCH_SEEN_URL_LIMIT=200
OPENAI_COLLECTION_TIMEOUT_SECONDS=120
OPENAI_COLLECTION_MIN_RELEVANCE=45
OPENAI_WEB_RESEARCH_DEEP_EXTRACT=true
OPENAI_WEB_RESEARCH_DEEP_EXTRACT_LIMIT=12
OPENAI_WEB_RESEARCH_DEEP_EXTRACT_CONCURRENCY=5
OPENAI_URL_SCRAPE_CONCURRENCY=5
LEAD_BACKFILL_ON_INGESTION=true
# Optional next step for more volume: set real Reddit API creds and Google Alert RSS feed URLs.

# App runtime (async). On Neon/Supabase you may use postgresql+asyncpg://... with ?ssl=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kramaai_leads
# Alembic migrations (sync). If unset, CI falls back to DATABASE_URL (async URLs are coerced for migrate only).
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kramaai_leads

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_CHANNEL=#kramaai-market-listening
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Sources — fill in real values or collectors will no-op
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=kramaai-lead-monitor/1.0
REDDIT_SUBREDDITS=smallbusiness,fitnessbusiness,martialarts,gymowners,yoga,pilates,crossfit,SaaS
# One Google Alert RSS feed per competitor (e.g. "Mindbody" switching, "Pike13" alternative)
GOOGLE_ALERT_RSS_URLS=
# Optional https pages to scrape (prefer Reddit/public blogs — G2/Capterra often 403)
OPENAI_SCRAPER_URLS=

KEYWORDS=MyStudio issues,MyStudio alternative,Pike13 problems,iClassPro complaints,Zen Planner issues,WellnessLiving complaints,Mindbody pricing,Jackrabbit support issue,Gymdesk alternatives,Vagaro billing issues
MAX_ITEMS_PER_QUERY=25
DUPLICATE_SIMILARITY_THRESHOLD=85
DEDUPE_CANDIDATE_WINDOW=200
DUPLICATE_WINDOW_DAYS=21
# Demo-only fake sources; keep false for production.
ENABLE_PLACEHOLDER_SOURCES=false
REPORT_OUTPUT_DIR=reports
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_HOUR=19
SCHEDULER_MINUTE=30
